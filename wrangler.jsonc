{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proconect-b2b",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proconect-b2b-db",
      "database_id": "6624aba0-1008-423d-8599-1e840a60cadc",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "proconect-b2b-files"
    }
  ]
}
